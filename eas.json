{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20.19.4",
      "channel": "development"
    },
  "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20.19.4",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_KEY": "Growshelby_MVP_Secret_2026",
        "EXPO_PUBLIC_EMAILJS_SERVICE_ID": "YOUR_EMAILJS_SERVICE_ID",
        "EXPO_PUBLIC_EMAILJS_TEMPLATE_ID": "YOUR_EMAILJS_TEMPLATE_ID",
        "EXPO_PUBLIC_EMAILJS_PUBLIC_KEY": "YOUR_EMAILJS_PUBLIC_KEY",
        "EXPO_PUBLIC_IMGBB_KEY": "YOUR_IMGBB_KEY"
      }
    },
 "production": {
      "autoIncrement": true,
      "node": "20.19.4",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_KEY": "Growshelby_MVP_Secret_2026",
        "EXPO_PUBLIC_EMAILJS_SERVICE_ID": "YOUR_EMAILJS_SERVICE_ID",
        "EXPO_PUBLIC_EMAILJS_TEMPLATE_ID": "YOUR_EMAILJS_TEMPLATE_ID",
        "EXPO_PUBLIC_EMAILJS_PUBLIC_KEY": "YOUR_EMAILJS_PUBLIC_KEY",
        "EXPO_PUBLIC_IMGBB_KEY": "YOUR_IMGBB_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}